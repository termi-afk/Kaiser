+/******************************************************************
+ *		WINHELP_OpenContextPopup
+ *
+ * Shows a topic, given by its context number, as a popup at the mouse cursor: what an
+ * application gets for WinHelp(HELP_CONTEXTPOPUP) and help files for the PopupContext macro.
+ * The popup closes on the next click, inside or outside of it.
+ */
+BOOL WINHELP_OpenContextPopup(HLPFILE* hlpfile, LONG context)
+{
+    static HLPFILE_WINDOWINFO   wi;
+    POINT                       pt;
+    int                         cxScreen = GetSystemMetrics(SM_CXSCREEN);
+
+    if (Globals.active_popup)
+    {
+        WINHELP_WINDOW* popup = Globals.active_popup;
+        Globals.active_popup = NULL;
+        WINHELP_ReleaseWindow(popup);
+    }
+
+    wi.type[0] = wi.name[0] = wi.caption[0] = '\0';
+    wi.size.cx = min(cxScreen * 2 / 3, 560);
+    wi.size.cy = 10; /* need a non null value, so that borders are taken into account while computing */
+
+    GetCursorPos(&pt);
+    wi.origin.x = pt.x - wi.size.cx / 2;
+    wi.origin.x = min(wi.origin.x, cxScreen - wi.size.cx);
+    wi.origin.x = max(wi.origin.x, 0);
+    wi.origin.y = pt.y + 8;
+
+    wi.style = SW_SHOW;
+    wi.win_style = WS_POPUP | WS_BORDER;
+    if (hlpfile->has_popup_color)
+        wi.sr_color = hlpfile->popup_color;
+    else
+        wi.sr_color = WINHELP_GetWindowInfo(hlpfile, "main")->sr_color;
+    wi.nsr_color = 0xFFFFFF;
+
+    return WINHELP_OpenHelpWindow(HLPFILE_PageByMap, hlpfile, context, &wi, SW_NORMAL);
+}
+
 typedef struct
 {
     WORD size;
